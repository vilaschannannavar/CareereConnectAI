# ==========================================
# CareerConnect AI - Environment Configuration
# NEVER COMMIT REAL SECRETS OR .env FILES.
# Copy this file to .env and replace placeholders.
# ==========================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="CareerConnect AI"
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Security & Sessions
# Generate secure 32+ char secrets: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_secure_random_hex_string_32_chars_min
# Fernet key (32 url-safe base64-encoded bytes): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change_me_to_a_valid_fernet_base64_encoded_key_placeholder=
SESSION_COOKIE_NAME=careerconnect_session
SESSION_MAX_AGE_SECONDS=604800
SECURE_COOKIES=false

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=careerconnect
POSTGRES_PASSWORD=careerconnect_dev_password
POSTGRES_DB=careerconnect_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://careerconnect:careerconnect_dev_password@127.0.0.1:5432/careerconnect_dev

# Storage Configuration
# local (private dir) or s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/private_storage
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# LLM Provider Configuration
# Supported providers: gemini, openai, mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_placeholder
OPENAI_API_KEY=your_openai_api_key_placeholder
LLM_MODEL_NAME=gemini-1.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=1
LLM_USER_BUDGET_CAP_USD=1.00
LLM_ESTIMATED_COST_PER_CALL_USD=0.005

# Antivirus Scanning Hook
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# LinkedIn Integration (Mock / CSV default; enterprise API disabled)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_placeholder
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_placeholder
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback
